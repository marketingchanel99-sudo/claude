# 한글 폰트 경로 (비워두면 OS별 기본 폰트를 자동 탐색)
FONT_PATH=

# --- YouTube (Google Cloud Console > OAuth 클라이언트 ID(데스크톱 앱) > JSON 다운로드) ---
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_PRIVACY=public            # public | unlisted | private

# --- Instagram (비즈니스/크리에이터 계정 + 페이스북 페이지 연결 필요) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# --- TikTok (developers.tiktok.com 앱, video.publish 스코프) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 심사 전 앱은 SELF_ONLY(나만 보기)만 가능
TIKTOK_PRIVACY=SELF_ONLY
